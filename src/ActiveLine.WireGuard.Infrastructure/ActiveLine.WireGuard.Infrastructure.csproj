<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ActiveLine.WireGuard.Domain\ActiveLine.WireGuard.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixa versões corrigidas de dependências transitivas do SDK Pulumi (NU1902) -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="Pulumi" Version="3.114.0" />
    <PackageReference Include="Pulumi.Command" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts shell embarcados na DLL: ScriptLibrary lê pelo nome lógico "Docker/install.sh" -->
    <EmbeddedResource Include="Scripts\**\*.sh" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
